#compdef awsctx
#
# Completion for awsctx: profile names, described by account, role and region.

autoload -Uz _awsctx_profiles

local row
local -a fields profiles
for row in "${(@f)$(_awsctx_profiles)}"; do
  [[ -z "${row}" ]] && continue
  fields=("${(@ps:\t:)row}")
  # _describe entries are "value:description"; escape colons in the name
  profiles+=("${fields[1]//:/\\:}:${fields[2]}  ${fields[3]}  ${fields[4]}")
done

_arguments \
  '(-l --list)'{-l,--list}'[list profiles with account, role and region]' \
  '1:aws profile:{_describe "aws profile" profiles}'

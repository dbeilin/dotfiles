#autoload
#
# List AWS profiles by reading the config files directly. This is much faster
# than `aws configure list-profiles`, which matters for tab completion.
#
# Outputs one tab-separated line per profile:
#   name  account  role  region  sso
# Missing values are "-". sso is the profile's sso_session, or "legacy" when
# it sets sso_start_url inline.
#
# Shared by awsctx and its completion function, _awsctx.

emulate -L zsh
setopt extended_glob

local config_file="${AWS_CONFIG_FILE:-${HOME}/.aws/config}"
local creds_file="${AWS_SHARED_CREDENTIALS_FILE:-${HOME}/.aws/credentials}"
local header_re='^[[:space:]]*\[(.+)\][[:space:]]*$'

local -a names
local -A account role region sso
local line profile key value

# ~/.aws/config: "[default]" and "[profile <name>]" sections
if [[ -r "${config_file}" ]]; then
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ ${header_re} ]]; then
      case "${match[1]}" in
        default) profile='default' ;;
        profile\ *) profile="${match[1]#profile }" ;;
        *) profile='' ;;    # [sso-session ...], [services ...]
      esac
      [[ -n "${profile}" ]] && names+=("${profile}")
      continue
    fi

    [[ -z "${profile}" || "${line}" != *=* ]] && continue
    key="${${line%%=*}//[[:space:]]/}"
    value="${${line#*=}//[[:space:]]/}"

    case "${key}" in
      sso_account_id) account[${profile}]="${value}" ;;
      sso_role_name) role[${profile}]="${value}" ;;
      region) region[${profile}]="${value}" ;;
      sso_session) sso[${profile}]="${value}" ;;
      sso_start_url) sso[${profile}]="${sso[${profile}]:-legacy}" ;;
      role_arn)
        # arn:aws:iam::<account>:role/<name>
        account[${profile}]="${${value#arn:*:iam::}%%:*}"
        role[${profile}]="${value##*/}"
        ;;
    esac
  done < "${config_file}"
fi

# ~/.aws/credentials: "[<name>]" sections with static keys
if [[ -r "${creds_file}" ]]; then
  while IFS= read -r line || [[ -n "${line}" ]]; do
    [[ "${line}" =~ ${header_re} ]] && names+=("${match[1]}")
  done < "${creds_file}"
fi

for profile in "${(@u)names}"; do
  printf '%s\t%s\t%s\t%s\t%s\n' \
    "${profile}" \
    "${account[${profile}]:--}" \
    "${role[${profile}]:--}" \
    "${region[${profile}]:--}" \
    "${sso[${profile}]:--}"
done

#autoload
# Print one tab-separated line per AWS profile, without invoking the AWS CLI:
#   name <TAB> account <TAB> role <TAB> region <TAB> sso
# "sso" is the profile's sso_session name, "legacy" for an inline sso_start_url,
# or empty for non-SSO profiles. Shared by awsctx and its completion (_awsctx).

emulate -L zsh
setopt extended_glob

local config_file="${AWS_CONFIG_FILE:-$HOME/.aws/config}"
local creds_file="${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}"
local -a names
local -A account role region sso
local line section key value

if [[ -r "${config_file}" ]]; then
  while IFS= read -r line || [[ -n "${line}" ]]; do
    line="${line%%$'\r'}"
    if [[ "${line}" =~ '^[[:space:]]*\[(.+)\][[:space:]]*$' ]]; then
      section="${match[1]}"
      case "${section}" in
        default) ;;
        profile\ *) section="${section#profile }" ;;
        *) section="" ; continue ;;   # sso-session / services blocks
      esac
      (( ${names[(Ie)${section}]} )) || names+=("${section}")
      continue
    fi
    [[ -z "${section}" || "${line}" != *=* ]] && continue
    key="${${line%%=*}//[[:space:]]/}"
    value="${${line#*=}##[[:space:]]#}"
    value="${value%%[[:space:]]#}"
    case "${key}" in
      sso_account_id) account[${section}]="${value}" ;;
      sso_role_name)  role[${section}]="${value}" ;;
      region)         region[${section}]="${value}" ;;
      sso_session)    sso[${section}]="${value}" ;;
      sso_start_url)  [[ -z "${sso[${section}]}" ]] && sso[${section}]="legacy" ;;
      role_arn)
        account[${section}]="${${value#arn:aws*:iam::}%%:*}"
        role[${section}]="${value##*/}"
        ;;
    esac
  done < "${config_file}"
fi

# Profiles that only exist in the credentials file (static keys)
if [[ -r "${creds_file}" ]]; then
  while IFS= read -r line || [[ -n "${line}" ]]; do
    if [[ "${line}" =~ '^[[:space:]]*\[(.+)\][[:space:]]*$' ]]; then
      section="${match[1]}"
      (( ${names[(Ie)${section}]} )) || names+=("${section}")
    fi
  done < "${creds_file}"
fi

local name
for name in "${names[@]}"; do
  print -r -- "${name}"$'\t'"${account[${name}]}"$'\t'"${role[${name}]}"$'\t'"${region[${name}]}"$'\t'"${sso[${name}]}"
done

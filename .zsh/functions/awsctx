#
# Switch AWS profiles, logging in to SSO automatically when needed.
#
# Usage:
#   awsctx              pick a profile with fzf
#   awsctx -l|--list    list profiles with account, role and region
#   awsctx <profile>    switch to <profile>
#
# Switching exports AWS_PROFILE. If the profile uses SSO and its token is
# missing or expired, `aws sso login` runs before the switch is confirmed.
#
# Autoloaded from ~/.zsh/functions. The helpers below are defined on first
# call, then the last line runs awsctx itself.

#######################################
# Print an error message to STDERR.
# Arguments:
#   Message words.
#######################################
_awsctx_err() {
  echo "awsctx: $*" >&2
}

#######################################
# Align profile rows into "name  account  role  region" columns.
# Arguments:
#   Profile rows, as printed by _awsctx_profiles.
# Outputs:
#   One aligned line per row to STDOUT, in the same order.
#######################################
_awsctx_table() {
  local row
  for row in "$@"; do
    print -r -- "${row%$'\t'*}"    # drop the trailing sso field
  done | column -t -s $'\t'
}

#######################################
# Print all profiles, marking the active one.
# Globals:
#   AWS_PROFILE
# Arguments:
#   Profile rows, as printed by _awsctx_profiles.
# Outputs:
#   The profile table to STDOUT.
#######################################
_awsctx_list() {
  local line
  local current="${AWS_PROFILE:-default}"

  echo "Available AWS profiles:"
  for line in "${(@f)$(_awsctx_table "$@")}"; do
    if [[ "${line%% *}" == "${current}" ]]; then
      echo "* ${line}  (current)"
    else
      echo "  ${line}"
    fi
  done
}

#######################################
# Let the user pick a profile with fzf.
# Globals:
#   AWS_PROFILE
# Arguments:
#   Profile rows, as printed by _awsctx_profiles.
# Outputs:
#   The chosen profile name to STDOUT; nothing if the user cancelled.
# Returns:
#   1 if fzf is not installed.
#######################################
_awsctx_pick() {
  if (( ! ${+commands[fzf]} )); then
    _awsctx_err "fzf not found; use 'awsctx <profile>' or 'awsctx -l'"
    return 1
  fi

  local line
  line="$(_awsctx_table "$@" \
    | fzf --height=40% --reverse \
        --prompt='AWS Profile > ' \
        --header="Current: ${AWS_PROFILE:-default}")"
  [[ -n "${line}" ]] && print -r -- "${line%% *}"
}

#######################################
# Ask STS who the current credentials belong to.
# Outputs:
#   "<account> <TAB> <arn>" to STDOUT on success, the AWS CLI error otherwise.
# Returns:
#   Non-zero if the credentials could not be verified.
#######################################
_awsctx_whoami() {
  aws sts get-caller-identity --query '[Account,Arn]' --output text 2>&1
}

#######################################
# Export AWS_PROFILE, logging in to SSO first if the token has expired.
# Globals:
#   AWS_PROFILE (exported)
# Arguments:
#   Profile row, as printed by _awsctx_profiles.
# Outputs:
#   Progress and the verified identity to STDOUT, errors to STDERR.
# Returns:
#   1 if login failed or the credentials could not be verified.
#######################################
_awsctx_switch() {
  local -a fields=("${(@ps:\t:)1}")
  local name="${fields[1]}" role="${fields[3]}"
  local region="${fields[4]}" sso="${fields[5]}"
  local identity

  export AWS_PROFILE="${name}"

  identity="$(_awsctx_whoami)"
  if (( $? != 0 )) && [[ "${sso}" != '-' \
      && "${identity:l}" == *(sso|token)* ]]; then
    echo "SSO token for '${name}' is missing or expired, logging in..."
    if ! aws sso login --profile "${name}"; then
      _awsctx_err "SSO login failed for '${name}'"
      return 1
    fi
    identity="$(_awsctx_whoami)"
  fi

  if [[ "${identity}" != [0-9]##$'\t'arn:* ]]; then
    _awsctx_err "switched to '${name}', but couldn't verify credentials:"
    print -r -- "${identity}" >&2
    return 1
  fi

  local account="${identity%%$'\t'*}" arn="${identity#*$'\t'}"
  # Profiles without sso_role_name/role_arn: take the role from the ARN,
  # e.g. arn:aws:sts::123:assumed-role/MyRole/me -> MyRole/me
  [[ "${role}" == '-' ]] && role="${arn#*:*:*:*:*:*/}"

  echo "Switched to AWS profile: ${name}"
  echo "  account ${account}  role ${role}  region ${region}"
}

awsctx() {
  emulate -L zsh
  setopt extended_glob
  autoload -Uz _awsctx_profiles

  local -a rows
  rows=("${(@f)$(_awsctx_profiles)}")
  rows=(${rows:#})    # drop the empty element left when there are no profiles
  if (( ${#rows} == 0 )); then
    _awsctx_err "no profiles in ${AWS_CONFIG_FILE:-${HOME}/.aws/config}"
    return 1
  fi

  local name
  case "$1" in
    -l|--list)
      _awsctx_list "${rows[@]}"
      return
      ;;
    '')
      name="$(_awsctx_pick "${rows[@]}")" || return
      [[ -z "${name}" ]] && return 0
      ;;
    *) name="$1" ;;
  esac

  # The row whose first field is exactly ${name}. $'\t' isn't expanded
  # inside a (r) subscript, hence the variable.
  local tab=$'\t'
  local row="${rows[(r)${(b)name}${tab}*]}"
  if [[ -z "${row}" ]]; then
    _awsctx_err "unknown profile '${name}' (see 'awsctx -l')"
    return 1
  fi

  _awsctx_switch "${row}"
}

awsctx "$@"
